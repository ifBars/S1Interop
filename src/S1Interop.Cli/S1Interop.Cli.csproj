<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\S1Interop.Core\S1Interop.Core.csproj" />
    <ProjectReference Include="..\S1Interop.Compiler\S1Interop.Compiler.csproj" />
    <InternalsVisibleTo Include="S1Interop.Compiler.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>s1interop</ToolCommandName>
    <PackageId>S1Interop</PackageId>
    <Version>0.1.0-alpha.2</Version>
    <Authors>ifBars</Authors>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Description>Write Schedule One mods from one C# source with automatic Mono/IL2CPP compiler adaptation, project setup, diagnostics, and migration tools.</Description>
    <PackageTags>schedule-one;il2cpp;melonloader;modding;dotnet</PackageTags>
    <RepositoryUrl>https://github.com/ifBars/S1Interop</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ifBars/S1Interop</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
